---
import type { Breadcrumb } from "../types/Breadcrumb"

interface Props {
  title?: string,
  description?: string
  breadcrumbs?: Breadcrumb[]
  image?: string
  imageAlt?: string
  pubDate?: string
  pageType?: "website" | "article"
  author?: string
  noindex?: boolean
  schemas?: Record<string, unknown>[]
}

import "@fontsource/pixelify-sans";
import "@fontsource/space-grotesk";
import '@fontsource-variable/inter';

import AutumnBranches from "../components/AutumnBranches.astro"
import AutumnEasterEggs from "../components/AutumnEasterEggs.astro"
import AutumnFall from "../components/AutumnFall.astro"
import AutumnGround from "../components/AutumnGround.astro"
import AutumnSprites from "../components/AutumnSprites.astro"
import Breadcrumbs from "../components/Breadcrumbs.astro"
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import ResumeSnackbar from "../components/ResumeSnackbar"
import ScrollToTopButton from "../components/ScrollToTopButton.astro"
import Seo from "../components/Seo.astro"
import SvgIcons from "../components/SvgIcons.astro"
import { AUTUMN_END, AUTUMN_START, shouldRenderAutumn } from "../utils/season"

const { title, description, breadcrumbs, image, imageAlt, pubDate, pageType, author, noindex, schemas } = Astro.props
const { pathname } = Astro.url

// Le décor d'automne n'est généré qu'autour de la saison ; le script inline
// décide ensuite, chez le lecteur, s'il s'affiche.
const autumnDecor = shouldRenderAutumn(new Date())
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <link rel="apple-touch-icon" sizes="180x180" href="/favicons/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicons/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicons/favicon-16x16.png">
    <link rel="manifest" href="/favicons/site.webmanifest">

    <link rel="sitemap" href="/sitemap-index.xml" />

    <Seo
      title={title}
      description={description}
      image={image}
      imageAlt={imageAlt}
      pageType={pageType}
      pubDate={pubDate}
      author={author}
      noindex={noindex}
      breadcrumbs={breadcrumbs}
      schemas={schemas}
    />

    <script is:inline define:vars={{ autumnStart: AUTUMN_START, autumnEnd: AUTUMN_END }}>
      (function() {
        // « theme-summer » est désactivé : une valeur devenue invalide en
        // localStorage retombe sur la préférence système.
        const validTheme = ["theme-light", "theme-dark"]
        const userTheme = localStorage.getItem("theme")

        if (validTheme.includes(userTheme)) {
          document.documentElement.className = userTheme
        } else {
          const isDarkTheme = window.matchMedia("(prefers-color-scheme: dark)").matches
          document.documentElement.className = isDarkTheme ? "theme-dark" : "theme-light"
        }

        // Thème d'automne, par-dessus clair ou sombre. Actif par défaut pendant
        // la saison ; le couper vaut pour l'année en cours seulement.
        const now = new Date()
        const year = now.getFullYear()
        const start = new Date(year, autumnStart.month, autumnStart.day)
        const end = new Date(year, autumnEnd.month, autumnEnd.day + 1)

        if (now >= start && now < end) {
          document.documentElement.classList.add("season-available")
          if (localStorage.getItem("season") !== "classic-" + year) {
            document.documentElement.classList.add("season-autumn")
          }
        }
      }())
    </script>

    <link rel="stylesheet" href="/styles/normalize.css">
    <link rel="stylesheet" href="/styles/reset.css">
    <link rel="stylesheet" href="/styles/theme.css">

    <link
      rel="alternate"
      type="application/rss+xml"
      title="NX Academy"
      href={new URL("rss.xml", Astro.site)}
    />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Aller au contenu</a>
    <div class="page-wrapper">
      <SvgIcons />
      {autumnDecor && <AutumnSprites />}
      <Header />
      {autumnDecor && <AutumnBranches variant={pathname === "/" ? "large" : "small"} />}
      {
        pathname !== "/" && <Breadcrumbs breadcrumbs={breadcrumbs} />
      }
      <div id="main-content" tabindex="-1" style="flex: 1;">
        <slot />
      </div>
      {autumnDecor && <AutumnGround />}
      <Footer />
      <ScrollToTopButton />
      <ResumeSnackbar client:load />
      {autumnDecor && <AutumnFall />}
      {autumnDecor && <AutumnEasterEggs />}
    </div>
  </body>
</html>

<style is:global>
  html, body {
    height: 100%;
    margin: 0;
  }

  body {
    background-color: var(--backgroundColorPrimary);
    color: var(--textColor);
    font-family: 'Inter Variable', sans-serif;
  }

  h1,
  h2,
  h3 {
    font-family: "Space Grotesk", sans-serif;
    color: var(--title-color);
  }

  .page-wrapper {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  #main-content:focus {
    outline: none;
  }

  .skip-link {
    position: absolute;
    left: 8px;
    top: -100px;
    z-index: 1000;
    padding: 8px 16px;
    border-radius: 8px;
    background-color: var(--buttonColorPrimary);
    color: var(--buttonColorPrimaryText);
    text-decoration: none;
    transition: top 0.2s ease;
  }

  .skip-link:focus {
    top: 8px;
  }
</style>
