---
import type { News } from "../types/News";
interface Props extends News {}

import ParagraphSmall from "../components/ParagraphSmall.astro";
import ParagraphExtraSmall from "../components/ParagraphExtraSmall.astro";
import ParagraphLarge from "../components/ParagraphLarge.astro";
import { newsContext } from "../utils/news";

const { content, context, lecture, published, slug, title } = Astro.props;

// La carte est une accroche : elle s'en tient au contexte et renvoie vers la
// page de la brève, seul endroit où la lecture est donnée en entier. Une ancre
// dans /feed casserait dès que la brève tombe sur une page suivante du flux.
const summary = newsContext({ content, context, lecture });
---

<a class="wrapper" href={`/feed/${slug}`}>
  <ParagraphLarge content={title} />
  <ParagraphSmall content={summary} />
  <ParagraphExtraSmall content={published.toLocaleDateString("FR-fr")} />
</a>

<style>
  .wrapper {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;

    p:nth-of-type(1) {
      font-weight: 700;
      color: var(--linkColor);
      transition: 0.4s;
    }

    p:nth-of-type(2) {
      font-weight: 400;
    }
  }

  .wrapper:hover {
    p:nth-of-type(1) {
      color: var(--linkHoverColor);
    }
  }
</style>
